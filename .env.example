# Copie este archivo como .env y cambie los valores.

# Usuario y clave del panel de administrador (/admin)
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambie-esta-clave

# Frase secreta para las sesiones (larga y difícil de adivinar)
SESSION_SECRET=escriba-aqui-una-frase-larga-y-secreta

# Base de datos en la nube (Neon o Supabase). Déjela vacía en su computador.
DATABASE_URL=

# Gmail para enviar los avisos (contraseña de aplicación de 16 letras)
GMAIL_USUARIO=
GMAIL_CLAVE_APP=

# Opcional: guardar fotos subidas desde el panel en Cloudinary
CLOUDINARY_URL=

# Puerto (Render lo pone solo)
PORT=3000
